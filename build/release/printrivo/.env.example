# Copy to .env and set the externally visible URL, including any subdirectory.
CI_ENVIRONMENT = production
app.baseURL = 'https://YOUR_DOMAIN/'
app.indexPage = ''
# HTTPS production deployments:
app.forceGlobalSecureRequests = true
cookie.secure = true

# Required application database. Run php spark migrate --all.
database.default.hostname = 127.0.0.1
database.default.database = printrivo
database.default.username = ''
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix = po_
database.default.port = 3306
# Never expose writable/ or commit the database file.

# Optional default test admin, development/testing only. Set before migrate --all.
# Email: admin@printrivo.test. Use your own password of at least 12 characters.
# PRINTRIVO_TEST_ADMIN_PASSWORD = ''


# PayPal subscriptions (sandbox first). Fill these privately, then enable.
# Two separate active USD monthly plans: standard 9.99 and Alpha 4.99.
PayPal.enabled = false
PayPal.environment = live
PayPal.clientId = ''
PayPal.secret = ''
PayPal.webhookId = ''
PayPal.standardPlanId = ''
PayPal.alphaPlanId = ''
PayPal.currency = USD

# Dedicated 14-day free-trial plans (keep existing no-trial plans for returning members).
PayPal.standardTrialPlanId =
PayPal.alphaTrialPlanId =
# Stable random secret, at least 32 characters; never publish or rotate casually.
PayPal.trialHashKey =

# Google reCAPTCHA v3. Enable only after configuring real domain-specific keys.
recaptcha.enabled = false
recaptcha.siteKey =
recaptcha.secretKey =
recaptcha.hostname = YOUR_DOMAIN
recaptcha.minimumScore = 0.5

# Bug-report email recipient and sending configuration.
bugreports.recipient = info@mberdigital.com
# Configure a verified sender and your actual email delivery service in .env.
# email.fromEmail =
# email.fromName = Printrivo
# email.protocol = smtp
# email.SMTPHost =
# email.SMTPUser =
# email.SMTPPass =
# email.SMTPPort = 587
# email.SMTPCrypto = tls

# Optional GA4; see docs/GOOGLE_ANALYTICS.md
analytics.enabled = false
analytics.measurementId = ''
